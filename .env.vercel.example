# Environment variables to set in the Vercel project dashboard
# (Project Settings -> Environment Variables), scoped to Production
# (and Preview, if you want preview deployments to also work).
#
# Vercel injects these as real process environment variables at both
# build and runtime, so no .env file is deployed or needed.

APP_NAME=Gudangku
APP_ENV=production
APP_KEY=                      # generate locally with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

# Supabase Postgres (project: laravel-warehouse, ref: gtawruxkblejtqwpngvc).
# Use the connection pooler (port 6543, "Transaction" mode) rather than
# the direct connection (port 5432) — a serverless function opens a
# fresh DB connection per invocation, and the direct connection's limit
# is small enough that it can be exhausted quickly.
# DB_PASSWORD isn't listed here on purpose (Supabase never exposes it
# back once set) — get/reset it in the dashboard: this project ->
# Project Settings -> Database -> Connection Pooling / Reset Database Password.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.gtawruxkblejtqwpngvc
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.your-project.vercel.app
SANCTUM_STATEFUL_DOMAINS=your-project.vercel.app

CACHE_STORE=database
QUEUE_CONNECTION=database

# The deployed filesystem is read-only except /tmp (api/index.php
# already redirects storage_path() there), so send logs to stderr
# instead — Vercel captures stderr/stdout as function logs.
LOG_CHANNEL=stderr
